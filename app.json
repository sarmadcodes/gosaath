{
  "expo": {
    "name": "GoSaath",
    "slug": "gosaath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gosaath",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F5",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0F6E5C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0F6E5C",
          "dark": {
            "backgroundColor": "#101312"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GoSaath uses your photos so you can set a profile picture and upload your student card for verification.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gosaath.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gosaath.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F6E5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c9e75cd-b696-42c0-b907-e0a2e8617e57"
      }
    },
    "owner": "sarmadcodess",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8c9e75cd-b696-42c0-b907-e0a2e8617e57"
    }
  }
}
